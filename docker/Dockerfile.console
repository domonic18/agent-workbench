FROM node:22-bookworm-slim AS base
WORKDIR /app
# 显式装 pnpm 而非 corepack enable:corepack 在 Node 25+ 已移除,显式安装可跨基础镜像复用
RUN npm install -g pnpm@9.15.9

FROM base AS deps
# 依赖全为纯 JS(pg / fastify / zod),无 node-gyp 原生编译,不需要额外工具链
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json web/
COPY collector/package.json collector/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY web ./web
RUN pnpm run build

# 运行期只需生产依赖:Fastify / zod / pg 都是运行时依赖,不能靠 dev 依赖撑
FROM deps AS prod-deps
RUN pnpm install --frozen-lockfile --prod

FROM node:22-bookworm-slim AS runtime
ARG AW_UID=10001
ARG AW_GID=10001
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid "${AW_GID}" aw \
  && useradd --system --uid "${AW_UID}" --gid aw --home-dir /app --shell /usr/sbin/nologin aw \
  && mkdir -p /app/workspace \
  && chown -R aw:aw /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=prod-deps /app/node_modules ./node_modules
# 执行面安装脚本由控制台下发(/artifacts/install.sh),脚本本身在仓库内
COPY scripts/install-aw-node.sh ./scripts/install-aw-node.sh
USER aw
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server/main.js"]
