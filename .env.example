# agent-workbench 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 系统密钥只放 env;Agent / 采集器密钥由控制台签发,库中只存哈希

# ── 共用 ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── 服务器(宿主机进程) ───────────────────────────────
# 坑:容器内必须 0.0.0.0,否则端口不可达;对外由 compose 只绑 127.0.0.1
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./workspace/console.db

# 会话 Cookie 签名密钥:openssl rand -hex 32
SESSION_SECRET=

# 控制台登录口令(一期;二期飞书免登只覆盖只读)
CONSOLE_PASSWORD=

# ── 飞书 ─────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅与卡片回调的校验凭据,二者都必填
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 仅白名单 open_id 可建单/审批,逗号分隔
FEISHU_ALLOWED_OPEN_IDS=

# ── 采集器(每台机各一份,先到控制台注册取密钥) ─────────
AW_INGEST_URL=http://127.0.0.1:8787/api/ingest
AW_COLLECTOR_ID=
AW_COLLECTOR_SECRET=

# ── Agent 检索(与采集器密钥分离,不可复用) ─────────────
AW_KB_SEARCH_SECRET=

# ── Teleport ────────────────────────────────────────
TELEPORT_PROXY_ADDR=tp.17aitech.com:443
TELEPORT_ROLE=

# ── compose(仅容器部署需要) ──────────────────────────
# 容器内非 root 用户的 uid/gid:Linux 宿主机需与 workspace 目录属主一致
AW_UID=10001
AW_GID=10001

# ── frpc(仅 compose 的 tunnel profile 使用) ──────────
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=
