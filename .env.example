# agent-workbench 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 系统密钥只放 env;Agent / 采集器密钥由控制台签发,库中只存哈希

# ── 共用 ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── 服务器(宿主机进程) ───────────────────────────────
# 坑:容器内必须 0.0.0.0,否则端口不可达;对外由 compose 只绑 127.0.0.1
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./workspace/console.db

# 会话 Cookie 签名密钥:openssl rand -hex 32
SESSION_SECRET=

# 控制台登录口令:仅首次启动用于把哈希写入库,初始化后留空
CONSOLE_INIT_PASSWORD=

# ── 飞书 ─────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 消息与卡片回调均走长连接(应用凭据认证),无需公网回调地址
# Verification Token 可选:填了则额外比对入站消息事件的来源 token
# Encrypt Key:长连接不启用加密,固定留空
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 仅白名单 open_id 可下指令/审批,逗号分隔;留空 = 全部回执「无权限」
FEISHU_ALLOWED_OPEN_IDS=
# 授权申请卡片固定投递的群 chat_id(oc_ 开头);留空 = 不发卡片,改由控制台人工审批
FEISHU_APPROVAL_CHAT_ID=

# ── 采集器(每台机各一份,先到控制台注册取密钥) ─────────
AW_INGEST_URL=http://127.0.0.1:8787/api/ingest
AW_COLLECTOR_ID=
AW_COLLECTOR_SECRET=

# ── Agent 检索(与采集器密钥分离,不可复用) ─────────────
AW_KB_SEARCH_SECRET=

# ── MCP proxy(执行面,每台 Agent 机器一份) ─────────────
# RunContext 由代理注入;模型传入的 agent_id / role 一律丢弃
AW_RUN_ID=
AW_AGENT_ID=
# Agent Bearer 密钥:原生工具(task_create / a2a_send 等)经 HTTP 调控制台时使用
AW_AGENT_SECRET=
# 控制台地址;原生工具的业务写一律走控制面 API,不直连库
CONSOLE_URL=http://127.0.0.1:8787
AW_TASK_ID=
AW_WORKSPACE_ROOT=
# 上游 MCP server(JSON 数组),id 只允许 [a-z0-9-];
# toolMap 把上游工具名映射为闸门点分名,未映射一律按 L2 审批
# 例:[{"id":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/path"],"toolMap":{"read_text_file":"fs.read"}}]
AW_UPSTREAMS=
# 已生效授权:逗号分隔的 tool:capabilityId,如 fs.exec:cap_9f3a
# capabilityId 会写入 tool_call_log,供对账追到 Teleport 会话;格式非法即启动失败
AW_GRANTS=
# 审批挂起上限(毫秒),默认 300000
AW_APPROVAL_TIMEOUT_MS=300000
# 代理审计复用上面的 DATABASE_PATH 直连控制台库;容器运行时禁止从宿主机
# 对同一库开连接,需与库在同一环境运行,或等 M2.5-0 控制面 API 接入后改 HTTP

# ── Teleport ────────────────────────────────────────
TELEPORT_PROXY_ADDR=tp.example.com:443
TELEPORT_ROLE=
# 审计日志(events.log,JSONL)路径;配置后启动 5 分钟对账作业,读 session.start
# 核对 ticket_id ↔ aw_task_id。留空 = 不启动作业(接口仍可查,历史缺口为空)
TELEPORT_AUDIT_LOG_PATH=

# ── compose(仅容器部署需要) ──────────────────────────
# 容器内非 root 用户的 uid/gid:Linux 宿主机需与 workspace 目录属主一致
AW_UID=10001
AW_GID=10001

# ── frpc(仅 compose 的 tunnel profile 使用) ──────────
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=
