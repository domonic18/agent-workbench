# agent-workbench 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 系统密钥只放 env;Agent / 采集器密钥由控制台签发,库中只存哈希

# ── 共用 ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── 服务器(宿主机进程) ───────────────────────────────
# 坑:容器内必须 0.0.0.0,否则端口不可达;对外由 compose 只绑 127.0.0.1
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://agent_workbench@127.0.0.1:5433/agent_workbench
# Markdown 知识条目目录(文本真相源);chunk / FTS / 向量索引均可重建
KNOWLEDGE_DIR=./workspace/knowledge

# OpenAI 兼容嵌入接口;BASE_URL 与 MODEL 必须同时配置,留空 = 只建关键词索引
# 维度固定 768,需与 vec0 的 float[768] 一致,不一致按失败处理不截断
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 会话 Cookie 签名密钥:openssl rand -hex 32
SESSION_SECRET=

# 控制台登录口令:仅首次启动用于把哈希写入库,初始化后留空
CONSOLE_INIT_PASSWORD=
# 来源白名单(只校验 Host,含端口),逗号分隔;留空 = HOST:PORT + 127.0.0.1:PORT
# 经 frp 暴露时填实际访问域名,如 aw.example.com:8787
CONSOLE_ALLOWED_HOSTS=
# 对外可达的控制台地址(frp 公网入口);站点据此给出可复制到别的机器的下载地址
# 留空 = 站点按当前访问地址渲染
AW_PUBLIC_URL=

# ── 飞书 ─────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 消息与卡片回调均走长连接(应用凭据认证),无需公网回调地址
# Encrypt Key:长连接不启用加密,固定留空
FEISHU_ENCRYPT_KEY=
# 仅白名单 open_id 可下指令/审批,逗号分隔;留空 = 全部回执「无权限」
FEISHU_ALLOWED_OPEN_IDS=
# 授权申请卡片固定投递的群 chat_id(oc_ 开头);留空 = 不发卡片,改由控制台人工审批
FEISHU_APPROVAL_CHAT_ID=
# Agent 协作通知群 chat_id;留空 = 交接/完成不返回 notify,群通知整体关闭
FEISHU_COLLAB_CHAT_ID=

# ── aw-node(执行面,每台 Agent 机器一份) ───────────────
# 采集与调度共用同一进程;先到控制台注册取机器密钥,再安装 aw-node
AW_INGEST_URL=http://127.0.0.1:8787/api/ingest
AW_COLLECTOR_ID=
AW_COLLECTOR_SECRET=
# 本地状态目录(断点、spool、config-state.json);默认 ~/.aw-node
AW_STATE_DIR=
# 本机已登记的 cc-connect 项目名,逗号分隔
AW_AGENT_PROJECTS=
# 首次安装时回读历史会话(all / none,默认 none)
AW_BACKFILL=none

# Claude Code / cc-connect 数据目录(默认 ~/.claude / ~/.cc-connect)
AW_CLAUDE_DIR=
AW_CC_CONNECT_DIR=
# cc-connect TOML 配置路径;留空按默认候选路径探测
AW_CC_CONNECT_CONFIG=
# 受管 MCP 写入的 Claude Code 配置文件(默认 ~/.claude.json)
AW_CLAUDE_JSON=

# 调度模块(A2A / worker_inbox 自动唤醒)
# AW_DISPATCH_MS=30000          # 轮询间隔,0 表示关闭调度
# AW_SESSION_TIMEOUT_MS=1800000 # 单次 headless 会话超时(毫秒),超时先 SIGTERM 再 SIGKILL
# AW_DISPATCH_MODEL=            # 调度会话指定模型,留空用 claude CLI 默认
# AW_DISPATCH_CLAUDE=           # claude 可执行文件路径,留空自动探测

# HTTP 请求超时(采集、收件箱探视共用,默认 30000ms,范围 1000~120000)
AW_REQUEST_TIMEOUT_MS=30000

# ── Agent 检索(与采集器密钥分离,不可复用) ─────────────
AW_KB_SEARCH_SECRET=

# ── Teleport ────────────────────────────────────────
TELEPORT_PROXY_ADDR=tp.example.com:443
TELEPORT_ROLE=
# 审计日志(events.log,JSONL)路径;配置后启动 5 分钟对账作业,读 session.start
# 核对 ticket_id ↔ aw_task_id。留空 = 不启动作业(接口仍可查,历史缺口为空)
TELEPORT_AUDIT_LOG_PATH=

# ── compose(仅容器部署需要) ──────────────────────────
# 容器内非 root 用户的 uid/gid:Linux 宿主机需与 workspace 目录属主一致
AW_UID=10001
AW_GID=10001

# ── frpc(仅 compose 的 tunnel profile 使用) ──────────
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=
POSTGRES_PASSWORD=
