# 环境变量与密钥(只提交 .env.example)
.env
.env.local
.env.*.local

# 宿主机持久化数据:内容不入库,保留目录骨架
workspace/*
!workspace/.gitkeep
!workspace/backups/
workspace/backups/*
!workspace/backups/.gitkeep
!workspace/collector/
workspace/collector/*
!workspace/collector/.gitkeep

# 依赖
node_modules/

# 构建产物
dist/
build/
.next/
coverage/
*.log
*.tsbuildinfo
.eslintcache

# 单实例锁(运行时产物,内含本机主机名与 IP,不入库)
console.lock

# Teleport spike 生成的 CA/证书/身份,只在本机跑
docker/spike/pki/
docker/spike/out/

# 浏览器自动化产物(Playwright MCP)
.playwright-mcp/

# archify 图示工具的工作目录(候选、渲染产物、校验回执,不入库)
.archify/

# cc-connect 桥的运行时附件目录(会话过程产物,不入库)
.cc-connect/

# IDE / 系统
.DS_Store
.idea/
.vscode/

# 本机 Claude Code 配置:skills 是绝对路径软链,只对当前机器有效
.claude/

# 真实基础设施信息只在本机(公开仓库内一律用占位符)
docs/plan/*.local.md

# 里程碑任务清单必须可入库(覆盖本机全局 *.md 忽略)
!docs/plan/tasks/*.md

# compose 插值密钥(2026-11-03 重基线)
docker/.env

# A2A 真机实测接入包:含 Agent Bearer 与一次性令牌,不入库
e2e/a2a-real/out/
e2e/a2a-real/.console-password
