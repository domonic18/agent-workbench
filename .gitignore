# 环境变量与密钥(只提交 .env.example)
.env
.env.local
.env.*.local

# 宿主机持久化数据:内容不入库,保留目录骨架
workspace/*
!workspace/.gitkeep
!workspace/backups/
workspace/backups/*
!workspace/backups/.gitkeep
!workspace/collector/
workspace/collector/*
!workspace/collector/.gitkeep

# 依赖
node_modules/

# 构建产物
dist/
build/
.next/
coverage/
*.log
*.tsbuildinfo
.eslintcache

# 本地容器配置(从 frpc.toml.example 复制)
docker/frpc.toml

# IDE / 系统
.DS_Store
.idea/
.vscode/
