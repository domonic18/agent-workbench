# 环境变量与密钥(只提交 .env.example)
.env
.env.local
.env.*.local

# 宿主机持久化数据:内容不入库,保留目录骨架
workspace/*
!workspace/.gitkeep
!workspace/backups/
workspace/backups/*
!workspace/backups/.gitkeep
!workspace/collector/
workspace/collector/*
!workspace/collector/.gitkeep

# 依赖
node_modules/

# 构建产物
dist/
build/
.next/
coverage/
*.log
*.tsbuildinfo
.eslintcache

# 本地容器配置(从 frpc.toml.example 复制)
docker/frpc.toml

# Teleport spike 生成的 CA/证书/身份,只在本机跑
docker/spike/pki/
docker/spike/out/

# IDE / 系统
.DS_Store
.idea/
.vscode/

# 本机 Claude Code 配置:skills 是绝对路径软链,只对当前机器有效
.claude/

# 真实基础设施信息只在本机(公开仓库内一律用占位符)
docs/plan/*.local.md
