{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "pnpm --filter @aw/web run dev",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/store/migrations-pg dist/store/migrations-pg && pnpm --filter @aw/web run build",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "pnpm --filter @aw/web run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:web": "pnpm --filter @aw/web run test",
    "check": "pnpm run typecheck && pnpm run typecheck:web && pnpm run lint && pnpm run test && pnpm run test:web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.12.7",
    "pg": "8.13.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
